[user]
	email = mail@marcuswilhelm.de
	name = Marcus Wilhelm
[diff]
	submodule = log
# icdiff not installed on this machine yet — reinstate when it is (pacman -S icdiff)
#    tool = icdiff
# [difftool]
#     prompt = false
# [difftool "icdiff"]
#   cmd = /usr/bin/icdiff --line-numbers $LOCAL $REMOTE
[credential]
	helper = store
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
    autoSetupRemote = true
    default = current
